// Prisma owns the data model (tables, enums, indexes).
// Supabase-specific concerns (RLS, triggers, realtime publication, auth FKs)
// live in supabase/sql/policies.sql and are applied via `bun run db:policies`.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["public"]
}

enum TenantRole {
  owner
  admin
  agent

  @@map("tenant_role")
  @@schema("public")
}

enum MessageSender {
  human
  lead
  ai

  @@map("message_sender")
  @@schema("public")
}

model Tenant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String   @unique
  name      String
  ownerId   String   @map("owner_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  members       TenantMember[]
  config        ChatbotConfig?
  conversations Conversation[]
  messages      Message[]

  @@index([ownerId], map: "tenants_owner_idx")
  @@map("tenants")
  @@schema("public")
}

model TenantMember {
  tenantId  String     @map("tenant_id") @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  role      TenantRole @default(agent)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, userId])
  @@index([userId], map: "tenant_members_user_idx")
  @@map("tenant_members")
  @@schema("public")
}

model ChatbotConfig {
  tenantId       String   @id @map("tenant_id") @db.Uuid
  botName        String   @default("Assistant") @map("bot_name")
  welcomeMessage String   @default("Hi! How can we help you today?") @map("welcome_message")
  primaryColor   String   @default("#4f46e5") @map("primary_color")
  textColor      String   @default("#ffffff") @map("text_color")
  position       String   @default("right")
  avatarUrl      String?  @map("avatar_url")
  aiEnabled      Boolean  @default(true) @map("ai_enabled")
  aiModel        String   @default("openai/gpt-4o-mini") @map("ai_model")
  aiSystemPrompt String   @default("You are a helpful customer support assistant. Be concise and friendly.") @map("ai_system_prompt")
  collectLead    Boolean  @default(true) @map("collect_lead")
  leadFields     Json     @default("[\"name\",\"email\"]") @map("lead_fields")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("chatbot_configs")
  @@schema("public")
}

model Conversation {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  visitorId      String   @map("visitor_id")
  visitorName    String?  @map("visitor_name")
  visitorEmail   String?  @map("visitor_email")
  status         String   @default("open")
  lastMessageAt  DateTime @default(now()) @map("last_message_at") @db.Timestamptz
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([tenantId, visitorId], map: "conversations_tenant_visitor_idx")
  @@index([tenantId, lastMessageAt(sort: Desc)], map: "conversations_tenant_idx")
  @@map("conversations")
  @@schema("public")
}

model Message {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String        @map("conversation_id") @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  sender         MessageSender
  authorId       String?       @map("author_id") @db.Uuid
  authorName     String?       @map("author_name")
  content        String
  metadata       Json          @default("{}")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt], map: "messages_conversation_idx")
  @@index([tenantId, createdAt(sort: Desc)], map: "messages_tenant_idx")
  @@map("messages")
  @@schema("public")
}
