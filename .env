# =============================================================================
# DEMO ENVIRONMENT — INTENTIONALLY PUBLIC
# =============================================================================
# These values are committed on purpose to make the demo runnable out of the
# box. The Supabase URL and `anon` key are designed to be public — they are
# safe to ship to the browser and are gated by Row Level Security.
#
# NEVER commit a value for SUPABASE_SERVICE_ROLE_KEY in a real project — it
# bypasses RLS. For this demo we leave it blank; copy it from
# Supabase → Project Settings → API into a local `.env.local` file.
#
# `.env.local` overrides this file and is gitignored.
# =============================================================================

# ---------- Supabase (PUBLIC values) ----------
NEXT_PUBLIC_SUPABASE_URL=https://ticdcnqmsexfwatbbptx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InRpY2RjbnFtc2V4ZndhdGJicHR4Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzgwNzU2MjAsImV4cCI6MjA5MzY1MTYyMH0.qyMbG_OtjnEzj-zKO074X7tuPI_tlvOITgCbbJlmeAA

# ---------- Supabase (SECRET — fill in .env.local) ----------
# Required for the visitor widget API (`/api/widget/*`) since anonymous
# visitors don't have an authenticated session.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- App ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Prisma / Postgres (only needed if running migrations locally) ----------
# Migrations for this demo were applied via the Supabase MCP. Leave these blank
# unless you intend to use `bun run db:setup` against your own project.
DATABASE_URL=
DIRECT_URL=

# ---------- OpenRouter (optional — disables AI auto-reply if blank) ----------
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
