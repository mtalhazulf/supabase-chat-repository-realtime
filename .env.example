# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public origin used by embed.js (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Prisma / Postgres ----------
# DATABASE_URL  — for the app at runtime (use the pooled "Transaction" URL: port 6543, ?pgbouncer=true)
# DIRECT_URL    — for migrations/policies (use the direct URL: port 5432)
# Get both from Supabase → Project → Settings → Database → Connection string.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ---------- OpenRouter ----------
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
